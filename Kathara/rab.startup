ip a add 192.168.10.126/25 dev eth0
ip a add 10.3.255.254/15 dev eth1
ip a add 192.168.50.1/30 dev eth2
ip a add 192.168.50.5/30 dev eth3
ip a add 192.168.50.9/30 dev eth4

echo 1 > /proc/sys/net/ipv4/ip_forward

iptables -A POSTROUTING -t nat -o eth5 -j MASQUERADE

ulimit -n 1024
/etc/init.d/quagga start

mkdir -p /var/lib/dhcp
touch /var/lib/dhcp/dhcpd.leases
dhcpd -4 -cf /etc/dhcp/dhcpd.conf eth0

echo "search bytza.izo" > /etc/resolv.conf
echo "nameserver 192.168.10.1" >> /etc/resolv.conf

iptables -A PREROUTING -t nat -i eth5 -p tcp --dport 80 -j DNAT --to-destination 192.168.10.2:80

iptables -A FORWARD -i eth5 -o eth0 -p tcp -d 192.168.10.2 --dport 80 -j ACCEPT
iptables -A FORWARD -i eth0 -o eth5 -p tcp -s 192.168.10.2 --sport 80 -m state --state ESTABLISHED,RELATED -j ACCEPT
